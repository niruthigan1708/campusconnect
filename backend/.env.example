DB_HOST=localhost
DB_PORT=5432
DB_NAME=campusconnect
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

SERVER_PORT=8080

# Generate your own with: openssl rand -base64 64
JWT_SECRET=change-this-to-a-long-random-secret-in-your-env-file-at-least-256-bits
JWT_EXPIRATION_MS=86400000

# If both are set, an admin account is created on startup (if one doesn't already exist).
# Public self-registration as ADMIN is blocked, so this is the only way to create one.
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Outgoing mail (used for password reset links). Leave MAIL_HOST blank for local
# dev - the reset link is just logged to the console instead of emailed.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@campusconnect.edu

# When true and the database is empty, seeds demo clubs/events/registrations on
# startup. See DemoDataSeeder. Leave false in any environment with real data.
SEED_DEMO_DATA=false
