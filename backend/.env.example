DB_HOST=localhost
DB_PORT=5432
DB_NAME=campusconnect
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

SERVER_PORT=8080

# Generate your own with: openssl rand -base64 64
JWT_SECRET=change-this-to-a-long-random-secret-in-your-env-file-at-least-256-bits
JWT_EXPIRATION_MS=86400000

# If both are set, an admin account is created on startup (if one doesn't already exist).
# Public self-registration as ADMIN is blocked, so this is the only way to create one.
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
